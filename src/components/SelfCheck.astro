---
import { symptoms, maxScore } from '../data/symptoms';
import { site } from '../data/site';

/**
 * The interactive core of the site.
 *
 * Why this exists: DBU's patients have spent years being told their symptom is
 * unrelated to their jaw. The tool's job is to show the *connection* - select a
 * symptom, watch it light up on the head diagram, read why it traces back to
 * the joint. The score is secondary to that moment of recognition.
 *
 * It screens. It does not diagnose, and it says so plainly.
 */

/** Hotspot positions on the profile diagram, keyed to Symptom.region. */
const hotspots: Record<string, { x: number; y: number; label: string }> = {
  temple: { x: 252, y: 162, label: 'Temple' },
  cheek: { x: 238, y: 228, label: 'Cheek' },
  teeth: { x: 268, y: 254, label: 'Teeth' },
  jaw: { x: 152, y: 246, label: 'Jaw joint' },
  ear: { x: 124, y: 224, label: 'Ear' },
  neck: { x: 186, y: 366, label: 'Neck' },
};
---

<section
  id="self-check"
  class="relative overflow-hidden bg-ink py-24 text-paper sm:py-32"
  aria-labelledby="self-check-heading"
>
  <div
    class="pointer-events-none absolute -right-40 top-0 h-[42rem] w-[42rem] rounded-full bg-ox-600/25 blur-[120px]"
    aria-hidden="true"
  >
  </div>

  <div class="wrap-wide relative">
    <div class="max-w-3xl" data-reveal>
      <span class="eyebrow !text-gold-400">
        <span class="h-px w-8 bg-gold-500"></span>
        Interactive self-check
      </span>
      <h2 id="self-check-heading" class="mt-6 text-5xl text-paper sm:text-6xl lg:text-7xl">
        Find out if your jaw is
        <span class="text-gold-400 italic">the reason.</span>
      </h2>
      <p class="mt-7 max-w-2xl text-lg leading-relaxed text-paper/70">
        Tick anything that sounds like you. Each one shows where it sits on the jaw system and why
        it traces back to the joint. Takes about a minute.
      </p>
    </div>

    <div class="mt-16 grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16">
      <!-- ============ Pain map ============ -->
      <div class="lg:sticky lg:top-28 lg:self-start" data-reveal>
        <div class="rounded-[2rem] border border-paper/10 bg-paper/[0.04] p-6 backdrop-blur-sm">
          <svg
            viewBox="0 0 400 440"
            class="mx-auto w-full max-w-[19rem]"
            role="img"
            aria-labelledby="painmap-title"
          >
            <title id="painmap-title">
              A side profile of the head showing where each selected symptom sits
            </title>

            <!-- Neck + head share one group opacity so the overlap does not
                 double up into a visible seam. -->
            <g class="text-paper" opacity="0.17" fill="currentColor">
              <path d="M158 306 C160 342 154 362 149 386 L227 386 C214 362 207 344 207 306 Z"></path>
              <path
                d="M150 28 C215 22 268 62 278 118 C282 142 279 158 286 166
                   C297 176 312 196 314 206 C315 213 305 218 296 220
                   C292 228 294 232 290 236 C283 240 276 242 274 248
                   C273 256 280 262 276 270 C271 282 258 292 250 300
                   C240 312 224 322 205 326 C180 331 158 328 142 320
                   C128 313 118 300 112 282 C104 258 98 232 98 196
                   C98 120 108 46 150 28 Z"></path>
            </g>

            <!-- profile outline, drawn on top so the face stays readable -->
            <path
              d="M150 28 C215 22 268 62 278 118 C282 142 279 158 286 166
                 C297 176 312 196 314 206 C315 213 305 218 296 220
                 C292 228 294 232 290 236 C283 240 276 242 274 248
                 C273 256 280 262 276 270 C271 282 258 292 250 300
                 C240 312 224 322 205 326 C180 331 158 328 142 320
                 C128 313 118 300 112 282 C104 258 98 232 98 196
                 C98 120 108 46 150 28 Z"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              class="text-paper/45"></path>

            <!-- ear -->
            <path
              d="M126 216 C138 212 146 222 145 236 C144 250 136 258 126 256 C118 254 116 220 126 216 Z"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              class="text-paper/40"></path>

            <!-- The jaw joint: always-on target rings, straight from the logo -->
            <g class="ring-pulse" aria-hidden="true">
              <circle cx="150" cy="244" r="16" fill="none" stroke="#C23B22" stroke-width="1.6"
              ></circle>
              <circle cx="150" cy="244" r="16" fill="none" stroke="#C23B22" stroke-width="1.6"
              ></circle>
              <circle cx="150" cy="244" r="16" fill="none" stroke="#C23B22" stroke-width="1.6"
              ></circle>
            </g>
            <circle cx="150" cy="244" r="4" fill="#C23B22"></circle>

            <!-- Symptom hotspots, activated from the checklist -->
            {
              Object.entries(hotspots).map(([region, h]) => (
                <g data-hotspot={region} class="opacity-0 transition-opacity duration-500">
                  <circle
                    cx={h.x}
                    cy={h.y}
                    r="21"
                    fill="#C23B22"
                    opacity="0.16"
                    data-hotspot-halo
                  />
                  <circle cx={h.x} cy={h.y} r="7" fill="#C23B22" />
                  <circle cx={h.x} cy={h.y} r="7" fill="none" stroke="#F7F4EE" stroke-width="1.5" />
                </g>
              ))
            }
          </svg>

          <p class="mt-4 text-center text-[0.78rem] text-paper/45">
            The rings mark the temporomandibular joint - where the jaw meets the skull.
          </p>
        </div>

        <!-- Live score -->
        <div class="mt-5 rounded-3xl border border-paper/10 bg-paper/[0.04] p-6">
          <div class="flex items-baseline justify-between">
            <span class="text-[0.7rem] font-medium uppercase tracking-[0.18em] text-paper/45">
              Signal strength
            </span>
            <span class="font-display text-2xl text-gold-400">
              <span data-score>0</span><span class="text-paper/35 text-lg">/{maxScore}</span>
            </span>
          </div>
          <div
            class="mt-3 h-2 w-full overflow-hidden rounded-full bg-paper/10"
            role="progressbar"
            aria-valuemin="0"
            aria-valuemax={maxScore}
            aria-valuenow="0"
            aria-label="TMJ symptom signal strength"
            data-score-bar
          >
            <div
              class="h-full w-0 rounded-full bg-gradient-to-r from-gold-500 to-signal transition-all duration-700 ease-out"
              data-score-fill
            >
            </div>
          </div>
        </div>
      </div>

      <!-- ============ Checklist ============ -->
      <div data-reveal style="--reveal-delay:120ms">
        <fieldset>
          <legend class="sr-only">Select the symptoms you experience</legend>
          <ul class="space-y-2.5">
            {
              symptoms.map((s) => (
                <li>
                  <label
                    class="group flex cursor-pointer gap-4 rounded-2xl border border-paper/10 bg-paper/[0.03] p-4
                           transition-all duration-300 hover:border-gold-500/40 hover:bg-paper/[0.06]
                           has-[:checked]:border-gold-500/70 has-[:checked]:bg-gold-500/[0.09]"
                  >
                    <input
                      type="checkbox"
                      class="sr-only"
                      data-symptom
                      value={s.id}
                      data-weight={s.weight}
                      data-region={s.region}
                    />

                    <span
                      class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full border border-paper/25
                             transition-all duration-300 group-has-[:checked]:border-gold-500 group-has-[:checked]:bg-gold-500"
                      aria-hidden="true"
                    >
                      <svg
                        width="12"
                        height="10"
                        viewBox="0 0 12 10"
                        fill="none"
                        class="scale-0 transition-transform duration-300 group-has-[:checked]:scale-100"
                      >
                        <path
                          d="M1 5l3.2 3.2L11 1.4"
                          stroke="#1C1613"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                    </span>

                    <span class="min-w-0">
                      <span class="block text-[0.98rem] font-medium leading-snug text-paper">
                        {s.label}
                      </span>
                      <span
                        class="mt-0 block max-h-0 overflow-hidden text-[0.87rem] leading-relaxed text-paper/60
                               transition-all duration-500 ease-out group-has-[:checked]:mt-2 group-has-[:checked]:max-h-40"
                      >
                        {s.why}
                      </span>
                    </span>
                  </label>
                </li>
              ))
            }
          </ul>
        </fieldset>

        <!-- ============ Result ============ -->
        <div
          data-result
          class="mt-8 rounded-[1.75rem] border border-gold-500/30 bg-gradient-to-br from-gold-500/[0.12] to-transparent p-7"
          role="status"
          aria-live="polite"
        >
          <p class="text-[0.7rem] font-medium uppercase tracking-[0.18em] text-gold-400">
            Your result
          </p>
          <h3 class="mt-3 font-display text-3xl text-paper" data-result-title>
            Nothing selected yet
          </h3>
          <p class="mt-3 text-[1.02rem] leading-relaxed text-paper/75" data-result-lede>
            Choose any symptom above that sounds like your experience.
          </p>
          <p class="mt-3 leading-relaxed text-paper/60" data-result-body></p>

          <div class="mt-6 flex flex-wrap gap-3" data-result-actions hidden>
            <a href="/book" class="btn-gold" data-magnetic="0.18">
              <span data-result-cta>Book the TMJ Health Screening</span>
            </a>
            <a
              href={site.contact.messengerHref}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-ghost-light"
            >
              Ask a question first
            </a>
          </div>

          <p class="mt-6 border-t border-paper/10 pt-5 text-[0.78rem] leading-relaxed text-paper/45">
            This is a screening prompt, not a diagnosis. Only a clinical examination can confirm TMJ
            Dysfunction - that is exactly what the {site.screening.duration} TMJ Health Screening is for.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { bands, maxScore } from '../data/symptoms';

  const boxes = document.querySelectorAll<HTMLInputElement>('[data-symptom]');
  if (boxes.length) {
    const scoreEl = document.querySelector<HTMLElement>('[data-score]')!;
    const fillEl = document.querySelector<HTMLElement>('[data-score-fill]')!;
    const barEl = document.querySelector<HTMLElement>('[data-score-bar]')!;
    const titleEl = document.querySelector<HTMLElement>('[data-result-title]')!;
    const ledeEl = document.querySelector<HTMLElement>('[data-result-lede]')!;
    const bodyEl = document.querySelector<HTMLElement>('[data-result-body]')!;
    const actionsEl = document.querySelector<HTMLElement>('[data-result-actions]')!;
    const ctaEl = document.querySelector<HTMLElement>('[data-result-cta]')!;

    const update = () => {
      let score = 0;
      const active = new Set<string>();

      boxes.forEach((b) => {
        if (!b.checked) return;
        score += Number(b.dataset.weight) || 0;
        if (b.dataset.region) active.add(b.dataset.region);
      });

      // Score + bar
      scoreEl.textContent = String(score);
      fillEl.style.width = `${Math.round((score / maxScore) * 100)}%`;
      barEl.setAttribute('aria-valuenow', String(score));

      // Light up the matching regions on the diagram
      document.querySelectorAll<SVGGElement>('[data-hotspot]').forEach((g) => {
        const on = active.has(g.dataset.hotspot!);
        g.style.opacity = on ? '1' : '0';
      });

      // Result band
      const band = bands.find((b) => score >= b.min && score <= b.max) ?? bands[0];
      titleEl.textContent = band.title;
      ledeEl.textContent = band.lede;
      bodyEl.textContent = band.body;

      if (band.cta) {
        actionsEl.hidden = false;
        ctaEl.textContent = band.cta;
      } else {
        actionsEl.hidden = true;
      }
    };

    boxes.forEach((b) => b.addEventListener('change', update));
    update();
  }
</script>
