---
import { site, navigation } from '../data/site';
import BookLink from './BookLink.astro';

interface Props {
  /** Hero behind the header is dark, so invert until the page is scrolled. */
  darkHero?: boolean;
}
const { darkHero = false } = Astro.props;

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => path === href || path.startsWith(href + '/');
---

<!-- Announcement bar: keeps the oxblood strip the clinic already uses -->
<div class="bg-ox-600 text-paper">
  <!-- On phones this collapses to one line: tagline + tap-to-call. The price
       line is the first thing to go, since it repeats further down the page. -->
  <div class="wrap-wide flex flex-wrap items-center justify-center gap-x-5 gap-y-1 py-2.5 text-center text-[0.75rem] tracking-wide sm:text-[0.78rem]">
    <span class="font-medium">{site.tagline}</span>
    <span class="hidden text-paper/40 md:inline">/</span>
    <span class="hidden text-paper/75 md:inline">
      TMJ Health Screening - {site.screening.priceDisplay}
    </span>
    <span class="text-paper/40">/</span>
    <a href={site.contact.mobileHref} class="text-gold-300 underline-offset-4 hover:underline">
      {site.contact.mobile}
    </a>
  </div>
</div>

<header
  data-header
  data-over-dark={darkHero ? '' : undefined}
  class="sticky top-0 z-50 border-b border-transparent transition-all duration-500
         [&.is-scrolled]:border-ink/10 [&.is-scrolled]:bg-paper/85 [&.is-scrolled]:backdrop-blur-xl
         [&.is-scrolled]:shadow-[0_1px_30px_-18px_rgba(28,22,19,0.5)]"
>
  <div class="wrap-wide flex items-center justify-between gap-6 py-4">
    <a href="/" class="shrink-0" aria-label={`${site.name} - home`}>
      <img
        src="/brand/dbu-logo.png"
        alt={`${site.name} logo`}
        width="3197"
        height="1972"
        class="h-11 w-auto sm:h-12"
        fetchpriority="high"
      />
    </a>

    <nav aria-label="Main" class="hidden items-center gap-7 xl:flex">
      {
        navigation.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'nav-link relative text-[0.86rem] font-medium transition-colors duration-300',
              'after:absolute after:-bottom-1.5 after:left-0 after:h-px after:bg-gold-500 after:transition-all after:duration-300',
              isActive(item.href)
                ? 'text-ox-600 after:w-full'
                : 'text-ink-soft after:w-0 hover:text-ox-600 hover:after:w-full',
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-3">
      <a
        href={site.contact.mobileHref}
        class="hdr-phone hidden text-[0.86rem] font-medium text-ink-soft transition-colors hover:text-ox-600 lg:inline"
      >
        {site.contact.mobile}
      </a>
      <BookLink class="btn-primary hidden !px-6 !py-3 sm:inline-flex" data-magnetic="0.18">
        Book a Screening
      </BookLink>

      <button
        type="button"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="hdr-menu flex h-11 w-11 items-center justify-center rounded-full border border-ink/15 text-ink transition-colors hover:border-ox-600/40 xl:hidden"
      >
        <span class="sr-only">Open menu</span>
        <svg width="18" height="12" viewBox="0 0 18 12" fill="none" aria-hidden="true">
          <path d="M0 1h18M0 6h18M0 11h18" stroke="currentColor" stroke-width="1.5"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile panel -->
  <div
    id="mobile-menu"
    data-menu-panel
    hidden
    class="border-t border-ink/10 bg-paper/97 backdrop-blur-xl xl:hidden"
  >
    <nav aria-label="Mobile" class="wrap flex flex-col py-4">
      {
        navigation.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'border-b border-ink/[0.07] py-3.5 text-[1.05rem] font-medium transition-colors last:border-0',
              isActive(item.href) ? 'text-ox-600' : 'text-ink-soft hover:text-ox-600',
            ]}
          >
            {item.label}
          </a>
        ))
      }
      <div class="mt-5 flex flex-col gap-3 pb-2">
        <BookLink class="btn-primary w-full">Book a Screening</BookLink>
        <a href={site.contact.mobileHref} class="btn-ghost w-full">
          Call {site.contact.mobile}
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const panel = document.querySelector<HTMLElement>('[data-menu-panel]');

  if (toggle && panel) {
    const setOpen = (open: boolean) => {
      panel.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
      toggle.querySelector('span')!.textContent = open ? 'Close menu' : 'Open menu';
    };

    // `hidden` is typed boolean | string (for hidden="until-found"), so coerce.
    toggle.addEventListener('click', () => setOpen(Boolean(panel.hidden)));

    // Close on Escape, and whenever we grow past the mobile breakpoint.
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panel.hidden) {
        setOpen(false);
        toggle.focus();
      }
    });
    window.matchMedia('(min-width: 1280px)').addEventListener('change', (e) => {
      if (e.matches) setOpen(false);
    });
  }
</script>
