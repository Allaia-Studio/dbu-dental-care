---
import { site } from '../data/site';
import ChannelIcon from './ChannelIcon.astro';

/**
 * Two patterns, one component:
 *  - desktop: an expanding FAB stack, bottom-right
 *  - mobile:  a fixed bottom action bar, because in PH the tap-to-chat path
 *             (Messenger / WhatsApp / Viber) converts far harder than a form
 *
 * Every "Book" target reads site.booking.url, so pointing the site at a real
 * booking system is a one-line change in src/data/site.ts.
 */

const bookHref = site.booking.url;
const bookIsExternal = /^https?:\/\//.test(bookHref);

type Channel = {
  key: string;
  label: string;
  sub: string;
  href: string;
  brand: string;
  icon: 'messenger' | 'whatsapp' | 'viber' | 'phone' | 'email' | 'calendar';
  /** Shown in the compact mobile bar as well as the desktop panel. */
  onMobile?: boolean;
  external?: boolean;
};

const channels: Channel[] = [
  {
    key: 'messenger',
    label: 'Messenger',
    sub: 'Chat on Facebook',
    href: site.contact.messengerHref,
    brand: '#0084FF',
    icon: 'messenger',
    onMobile: true,
    external: true,
  },
  {
    key: 'whatsapp',
    label: 'WhatsApp',
    sub: site.contact.whatsapp,
    href: site.contact.whatsappHref,
    brand: '#25D366',
    icon: 'whatsapp',
    onMobile: true,
    external: true,
  },
  {
    key: 'viber',
    label: 'Viber',
    sub: site.contact.viber,
    href: site.contact.viberHref,
    brand: '#7360F2',
    icon: 'viber',
    onMobile: true,
  },
  {
    key: 'call',
    label: 'Call the clinic',
    sub: site.contact.mobileIntl,
    href: site.contact.mobileHref,
    brand: '#5B0F00',
    icon: 'phone',
    onMobile: true,
  },
  {
    key: 'email',
    label: 'Email us',
    sub: site.contact.email,
    href: site.contact.emailHref,
    brand: '#AD9952',
    icon: 'email',
  },
];

const mobileChannels = channels.filter((c) => c.onMobile);
---

<!-- ============ Desktop: expanding FAB ============ -->
<div class="pointer-events-none fixed bottom-6 right-6 z-40 hidden flex-col items-end gap-3 md:flex">
  <div
    id="contact-fab-panel"
    data-fab-panel
    hidden
    class="pointer-events-auto flex w-[20rem] flex-col gap-1.5 rounded-3xl border border-ink/10
           bg-paper/95 p-2.5 shadow-[0_28px_70px_-24px_rgba(28,22,19,0.45)] backdrop-blur-xl"
  >
    <p class="px-3 pb-1 pt-2 text-[0.7rem] font-medium uppercase tracking-[0.18em] text-ink-mute">
      Talk to us
    </p>

    {
      channels.map((c) => (
        <a
          href={c.href}
          target={c.external ? '_blank' : undefined}
          rel={c.external ? 'noopener noreferrer' : undefined}
          class="group flex items-center gap-3.5 rounded-2xl px-3 py-2.5 transition-colors duration-300 hover:bg-ink/[0.045]"
        >
          <span
            class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full text-white transition-transform duration-300 group-hover:scale-105"
            style={`background:${c.brand}`}
          >
            <ChannelIcon name={c.icon} size={19} knockout={c.brand} />
          </span>
          <span class="min-w-0">
            <span class="block text-[0.9rem] font-medium leading-tight text-ink">{c.label}</span>
            <span class="block truncate text-[0.78rem] text-ink-mute">{c.sub}</span>
          </span>
        </a>
      ))
    }

    <a
      href={bookHref}
      target={bookIsExternal ? '_blank' : undefined}
      rel={bookIsExternal ? 'noopener noreferrer' : undefined}
      class="mt-1.5 flex items-center justify-center gap-2.5 rounded-2xl bg-ox-600 px-3 py-3.5
             text-[0.9rem] font-medium text-paper transition-colors duration-300 hover:bg-ox-500"
    >
      <ChannelIcon name="calendar" size={17} />
      {site.booking.label} - {site.screening.priceDisplay}
    </a>

    <p class="px-3 pb-1.5 pt-2 text-[0.72rem] leading-relaxed text-ink-mute">
      Mon - Fri, 10:00 am - 7:00 pm. Messages outside clinic hours are answered the next working day.
    </p>
  </div>

  <button
    type="button"
    data-fab-toggle
    aria-expanded="false"
    aria-controls="contact-fab-panel"
    class="pointer-events-auto group relative flex items-center gap-3 rounded-full bg-ox-600 px-6 py-4
           text-paper shadow-[0_18px_44px_-14px_rgba(91,15,0,0.7)] transition-all duration-300
           hover:-translate-y-0.5 hover:bg-ox-500"
  >
    <!-- The logo's pain-target rings, reused as a live pulse -->
    <span class="ring-pulse pointer-events-none absolute inset-0" aria-hidden="true">
      <span class="absolute inset-0 rounded-full border border-gold-500/60"></span>
      <span class="absolute inset-0 rounded-full border border-gold-500/60"></span>
      <span class="absolute inset-0 rounded-full border border-gold-500/60"></span>
    </span>

    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="relative">
      <path
        d="M12 2C6.5 2 2 6 2 11c0 2.6 1.3 5 3.3 6.6L4.6 22l4.3-2.2c1 .2 2 .3 3.1.3 5.5 0 10-4 10-9s-4.5-9-10-9z"
      ></path>
    </svg>
    <span class="relative text-[0.9rem] font-medium" data-fab-label>Talk to us</span>
  </button>
</div>

<!-- ============ Mobile: bottom action bar ============ -->
<div
  class="fixed bottom-0 left-0 right-0 z-40 border-t border-ink/10 bg-paper/95 backdrop-blur-xl
         shadow-[0_-8px_30px_-16px_rgba(28,22,19,0.4)] md:hidden"
  style="padding-bottom:env(safe-area-inset-bottom,0px)"
>
  <div class="grid grid-cols-5">
    {
      mobileChannels.map((c) => (
        <a
          href={c.href}
          target={c.external ? '_blank' : undefined}
          rel={c.external ? 'noopener noreferrer' : undefined}
          aria-label={`${c.label} - ${c.sub}`}
          class="flex flex-col items-center gap-1 py-2.5 text-[0.6rem] font-medium text-ink-soft transition-colors active:bg-ink/5"
        >
          <span style={`color:${c.brand}`}>
            <ChannelIcon name={c.icon} size={20} knockout="#F7F4EE" />
          </span>
          {c.label === 'Call the clinic' ? 'Call' : c.label}
        </a>
      ))
    }

    <a
      href={bookHref}
      target={bookIsExternal ? '_blank' : undefined}
      rel={bookIsExternal ? 'noopener noreferrer' : undefined}
      aria-label={`${site.booking.label} - ${site.screening.priceDisplay}`}
      class="flex flex-col items-center gap-1 bg-ox-600 py-2.5 text-[0.6rem] font-medium text-paper transition-colors active:bg-ox-500"
    >
      <span class="text-gold-400"><ChannelIcon name="calendar" size={20} /></span>
      Book
    </a>
  </div>
</div>

<!-- Keeps the mobile bar from sitting on top of footer content -->
<div
  class="md:hidden"
  style="height:calc(4.25rem + env(safe-area-inset-bottom,0px))"
  aria-hidden="true"
>
</div>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-fab-toggle]');
  const panel = document.querySelector<HTMLElement>('[data-fab-panel]');
  const label = document.querySelector<HTMLElement>('[data-fab-label]');

  if (toggle && panel && label) {
    const setOpen = (open: boolean) => {
      panel.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
      label.textContent = open ? 'Close' : 'Talk to us';
    };

    // `hidden` is typed boolean | string (for hidden="until-found"), so coerce.
    toggle.addEventListener('click', () => setOpen(Boolean(panel.hidden)));

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panel.hidden) {
        setOpen(false);
        toggle.focus();
      }
    });

    document.addEventListener('click', (e) => {
      if (panel.hidden) return;
      const t = e.target as Node;
      if (!panel.contains(t) && !toggle.contains(t)) setOpen(false);
    });
  }
</script>
