---
import { site } from '../data/site';
import ChannelIcon from './ChannelIcon.astro';

/**
 * Two patterns, one component:
 *  - desktop: an expanding FAB stack, bottom-right
 *  - mobile:  a fixed bottom action bar, because in PH the tap-to-chat path
 *             (Messenger / WhatsApp / Viber) converts far harder than a form
 *
 * Every "Book" target reads site.booking.url, so pointing the site at a real
 * booking system is a one-line change in src/data/site.ts.
 */

const bookHref = site.booking.url;
const bookIsExternal = /^https?:\/\//.test(bookHref);

type Channel = {
  key: string;
  label: string;
  sub: string;
  href: string;
  brand: string;
  icon: 'messenger' | 'whatsapp' | 'viber' | 'phone' | 'email' | 'calendar';
  /** Shown in the compact mobile bar as well as the desktop panel. */
  onMobile?: boolean;
  external?: boolean;
};

const channels: Channel[] = [
  {
    key: 'messenger',
    label: 'Messenger',
    sub: 'Chat on Facebook',
    href: site.contact.messengerHref,
    brand: '#0084FF',
    icon: 'messenger',
    onMobile: true,
    external: true,
  },
  {
    key: 'whatsapp',
    label: 'WhatsApp',
    sub: site.contact.whatsapp,
    href: site.contact.whatsappHref,
    brand: '#25D366',
    icon: 'whatsapp',
    onMobile: true,
    external: true,
  },
  {
    key: 'viber',
    label: 'Viber',
    sub: site.contact.viber,
    href: site.contact.viberHref,
    brand: '#7360F2',
    icon: 'viber',
    onMobile: true,
  },
  {
    key: 'call',
    label: 'Call the clinic',
    sub: site.contact.mobileIntl,
    href: site.contact.mobileHref,
    brand: '#5B0F00',
    icon: 'phone',
    onMobile: true,
  },
  {
    key: 'email',
    label: 'Email us',
    sub: site.contact.email,
    href: site.contact.emailHref,
    brand: '#AD9952',
    icon: 'email',
  },
];

const mobileChannels = channels.filter((c) => c.onMobile);
---

<!-- ============ Desktop: always-visible channel rail ============ -->
<!-- Deliberately not collapsed behind a toggle. These are the highest-intent
     actions on the site, so they stay on screen and label themselves on hover. -->
<div class="pointer-events-none fixed bottom-6 right-6 z-40 hidden flex-col items-end gap-2.5 md:flex">
  {
    channels.map((c) => (
      <a
        href={c.href}
        target={c.external ? '_blank' : undefined}
        rel={c.external ? 'noopener noreferrer' : undefined}
        aria-label={`${c.label} - ${c.sub}`}
        class="channel-btn pointer-events-auto group flex items-center justify-end gap-0 rounded-full
               shadow-[0_14px_34px_-12px_rgba(28,22,19,0.5)] transition-all duration-300 hover:-translate-y-0.5"
        style={`background:${c.brand}`}
      >
        <span
          class="channel-label max-w-0 overflow-hidden whitespace-nowrap text-[0.85rem] font-medium
                 text-white opacity-0 transition-all duration-300"
        >
          <span class="block px-4">{c.label}</span>
        </span>
        <span class="flex h-13 w-13 shrink-0 items-center justify-center rounded-full text-white">
          <ChannelIcon name={c.icon} size={21} knockout={c.brand} />
        </span>
      </a>
    ))
  }

  <!-- Booking sits last and reads as the primary action -->
  <a
    href={bookHref}
    target={bookIsExternal ? '_blank' : undefined}
    rel={bookIsExternal ? 'noopener noreferrer' : undefined}
    data-magnetic="0.18"
    class="pointer-events-auto relative mt-1 flex items-center gap-2.5 rounded-full bg-ox-600 px-6 py-4
           text-paper shadow-[0_18px_44px_-14px_rgba(91,15,0,0.7)] transition-all duration-300
           hover:-translate-y-0.5 hover:bg-ox-500"
  >
    <span class="ring-pulse pointer-events-none absolute inset-0" aria-hidden="true">
      <span class="absolute inset-0 rounded-full border border-gold-500/60"></span>
      <span class="absolute inset-0 rounded-full border border-gold-500/60"></span>
      <span class="absolute inset-0 rounded-full border border-gold-500/60"></span>
    </span>
    <span class="relative flex items-center gap-2.5 text-[0.9rem] font-medium">
      <ChannelIcon name="calendar" size={17} />
      {site.booking.label}
    </span>
  </a>
</div>

<style>
  /* Label slides out of the circle on hover or keyboard focus */
  .channel-btn:hover .channel-label,
  .channel-btn:focus-visible .channel-label {
    max-width: 12rem;
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .channel-label {
      transition: none;
    }
  }
</style>

<!-- ============ Mobile: bottom action bar ============ -->
<div
  class="fixed bottom-0 left-0 right-0 z-40 border-t border-ink/10 bg-paper/95 backdrop-blur-xl
         shadow-[0_-8px_30px_-16px_rgba(28,22,19,0.4)] md:hidden"
  style="padding-bottom:env(safe-area-inset-bottom,0px)"
>
  <div class="grid grid-cols-5">
    {
      mobileChannels.map((c) => (
        <a
          href={c.href}
          target={c.external ? '_blank' : undefined}
          rel={c.external ? 'noopener noreferrer' : undefined}
          aria-label={`${c.label} - ${c.sub}`}
          class="flex flex-col items-center gap-1 py-2.5 text-[0.6rem] font-medium text-ink-soft transition-colors active:bg-ink/5"
        >
          <span style={`color:${c.brand}`}>
            <ChannelIcon name={c.icon} size={20} knockout="#F7F4EE" />
          </span>
          {c.label === 'Call the clinic' ? 'Call' : c.label}
        </a>
      ))
    }

    <a
      href={bookHref}
      target={bookIsExternal ? '_blank' : undefined}
      rel={bookIsExternal ? 'noopener noreferrer' : undefined}
      aria-label={`${site.booking.label} - ${site.screening.priceDisplay}`}
      class="flex flex-col items-center gap-1 bg-ox-600 py-2.5 text-[0.6rem] font-medium text-paper transition-colors active:bg-ox-500"
    >
      <span class="text-gold-400"><ChannelIcon name="calendar" size={20} /></span>
      Book
    </a>
  </div>
</div>

<!-- Keeps the mobile bar from sitting on top of footer content -->
<div
  class="md:hidden"
  style="height:calc(4.25rem + env(safe-area-inset-bottom,0px))"
  aria-hidden="true"
>
</div>
