---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ClosingCTA from '../components/ClosingCTA.astro';
import Photo from '../components/Photo.astro';
import { site, doctor, team, pillars } from '../data/site';

const physicianSchema = {
  '@type': 'Physician',
  '@id': `${site.url}/about#dr-uy`,
  name: doctor.name,
  jobTitle: doctor.role,
  medicalSpecialty: 'Dentistry',
  worksFor: { '@id': `${site.url}/#clinic` },
  alumniOf: doctor.education.map((e) => ({
    '@type': 'EducationalOrganization',
    name: e.school,
  })),
  memberOf: doctor.accreditations.map((a) => ({ '@type': 'Organization', name: a })),
};
---

<Base
  title="Dr. Diana Beverly Uy, TMJ Specialist"
  description="Dr. Diana Beverly Uy, founder and TMJ specialist at DBU Dental Care, Makati. Trained in the Philippines, Liechtenstein and Singapore."
  schema={[physicianSchema]}
>
  <PageHero
    eyebrow="About"
    title="The DBU in DBU Dental Care."
    lede={`${doctor.name} - ${doctor.role}. The clinic carries her initials because the TMJ Pain Management Program is hers.`}
  />

  <!-- Bio -->
  <section class="wrap py-24 sm:py-32" id="dr-uy">
    <div class="grid gap-14 lg:grid-cols-[0.85fr_1.15fr] lg:gap-20">
      <div class="lg:sticky lg:top-28 lg:self-start" data-reveal>
        <div class="relative rounded-[2rem] border border-ink/[0.08] bg-white/60 p-10">
          <img src="/brand/dbu-logo.png" alt="" width="3197" height="1972" class="w-full" loading="lazy" />
          <p class="mt-8 border-t border-ink/10 pt-6 text-[0.85rem] leading-relaxed text-ink-mute">
            A head in profile, and the pain radiating from one point - the temporomandibular joint.
            The mark has said what the clinic does since the beginning.
          </p>
        </div>

        <div class="mt-5">
          <Photo
            src="/photos/profile-window"
            alt="A woman standing in profile beside a window, lit from one side"
            ratio="4/5"
            tone="cool"
            sizes="(min-width: 1024px) 32vw, 100vw"
          />
        </div>

        <!-- Portraits of Dr Uy and the team are the client's to supply; we do not
             substitute stock people for real clinicians. -->
        <p class="mt-4 text-[0.8rem] leading-relaxed text-ink-mute">
          Portraits of Dr. Uy and the team to be supplied by DBU Dental Care. The photography here
          is atmospheric only.
        </p>
      </div>

      <div data-reveal style="--reveal-delay:100ms">
        <h2 class="text-4xl sm:text-5xl">{doctor.name}</h2>
        <p class="mt-3 text-[1.05rem] text-gold-600">{doctor.role}</p>

        <div class="mt-8 space-y-5 text-[1.08rem] leading-relaxed text-ink-soft">
          {doctor.bio.map((p) => <p>{p}</p>)}
        </div>

        <!-- Education -->
        <h3 class="mt-14 text-[0.7rem] font-medium uppercase tracking-[0.2em] text-ink-mute">
          Training
        </h3>
        <ol class="mt-6 space-y-px">
          {
            doctor.education.map((e) => (
              <li class="flex flex-wrap items-baseline gap-x-6 gap-y-1 border-t border-ink/10 py-4 last:border-b">
                <span class="font-display text-xl text-gold-600">{e.year}</span>
                <span class="flex-1 font-medium text-ink">{e.school}</span>
                <span class="text-[0.9rem] text-ink-mute">{e.place}</span>
              </li>
            ))
          }
        </ol>

        <!-- Accreditations -->
        <h3 class="mt-14 text-[0.7rem] font-medium uppercase tracking-[0.2em] text-ink-mute">
          Licences & accreditations
        </h3>
        <ul class="mt-6 grid gap-3 sm:grid-cols-2">
          {
            doctor.accreditations.map((a) => (
              <li class="flex gap-3.5 rounded-2xl border border-ink/[0.08] bg-white/50 p-5 text-[0.95rem] leading-relaxed text-ink-soft">
                <svg
                  width="15"
                  height="15"
                  viewBox="0 0 16 16"
                  fill="none"
                  class="mt-1 shrink-0 text-gold-600"
                  aria-hidden="true"
                >
                  <path
                    d="M1.5 8.5l4 4L14.5 3"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
                {a}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- Team -->
  <section class="relative overflow-hidden bg-paper-warm py-24 sm:py-32" aria-labelledby="team-heading">
    <div class="wrap">
      <div class="max-w-2xl" data-reveal>
        <span class="eyebrow"><span class="h-px w-8 bg-gold-500"></span>The team</span>
        <h2 id="team-heading" class="mt-6 text-4xl sm:text-5xl">
          Specialists for what sits beyond the joint.
        </h2>
        <p class="mt-6 leading-relaxed text-ink-soft">
          Complex cases rarely stay within one discipline. Dr. Uy works alongside colleagues in
          surgery, aesthetics and anaesthesiology.
        </p>
      </div>

      <ul class="mt-14 grid gap-5 md:grid-cols-3">
        {
          team.map((m, i) => (
            <li class="card p-9" data-reveal style={`--reveal-delay:${i * 80}ms`}>
              <span
                class="flex h-14 w-14 items-center justify-center rounded-full border border-gold-500/40 bg-gold-500/10 font-display text-xl text-gold-600"
                aria-hidden="true"
              >
                {m.name.replace('Dr. ', '').charAt(0)}
              </span>
              <h3 class="mt-6 text-2xl">{m.name}</h3>
              <p class="mt-2 text-[0.95rem] text-ink-mute">{m.field}</p>
              <p class="mt-1 text-[1.05rem] text-gold-600">{m.focus}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Pillars -->
  <section class="wrap py-24 sm:py-32" aria-labelledby="why-heading">
    <div class="max-w-2xl" data-reveal>
      <span class="eyebrow"><span class="h-px w-8 bg-gold-500"></span>Why DBU</span>
      <h2 id="why-heading" class="mt-6 text-4xl sm:text-5xl">What you are choosing.</h2>
    </div>

    <ol class="mt-14 grid gap-5 md:grid-cols-2">
      {
        pillars.map((p, i) => (
          <li class="card p-9" data-reveal style={`--reveal-delay:${(i % 2) * 80}ms`}>
            <span class="font-display text-4xl text-gold-500/50">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="mt-5 text-2xl">{p.title}</h3>
            <p class="mt-4 leading-relaxed text-ink-soft">{p.body}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <ClosingCTA />
</Base>
