---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { site } from '../data/site';
import { symptoms } from '../data/symptoms';

/**
 * Booking is deliberately dual-path.
 *
 * In PH, tap-to-chat converts far harder than a form, so Messenger / WhatsApp /
 * Call are the primary actions. The form is the secondary path for people who
 * prefer to write it out.
 *
 * The form has NO backend today: it composes a structured message and hands it
 * to the patient's own mail client, which works on static hosting from day one.
 * TO WIRE LATER: swap `buildMailto` for a real endpoint (Cal.com, Fresha or a
 * Cloudflare Worker) once Dr Uy picks a booking system.
 */

const reserveSchema = {
  '@type': 'Service',
  name: site.screening.name,
  provider: { '@id': `${site.url}/#clinic` },
  offers: {
    '@type': 'Offer',
    price: String(site.screening.price),
    priceCurrency: 'PHP',
    availability: 'https://schema.org/InStock',
  },
  potentialAction: {
    '@type': 'ReserveAction',
    target: `${site.url}/book`,
    result: { '@type': 'Reservation', name: 'TMJ Health Screening appointment' },
  },
};
---

<Base
  title="Book a TMJ Health Screening - Makati"
  description="Book the 15-minute TMJ Health Screening at DBU Dental Care, Makati. Php 3,800, ages 12+, no referral. Message, call or send a request."
  schema={[reserveSchema]}
>
  <PageHero
    eyebrow="Booking"
    title="Book your TMJ Health Screening."
    lede={`${site.screening.duration}, ${site.screening.priceDisplay}, ages ${site.screening.minAge} and up. No referral needed.`}
  />

  <!-- ========== Fast paths ========== -->
  <section class="wrap py-20 sm:py-24" aria-labelledby="fast-heading">
    <h2 id="fast-heading" class="text-3xl sm:text-4xl" data-reveal>
      Fastest way in - just message the clinic.
    </h2>
    <p class="mt-4 max-w-2xl leading-relaxed text-ink-soft" data-reveal style="--reveal-delay:60ms">
      Someone from the team answers during clinic hours, Monday to Friday, 10:00 am to 7:00 pm.
    </p>

    <div class="mt-10 grid gap-4 sm:grid-cols-3">
      {
        [
          {
            label: 'Messenger',
            sub: 'Chat on Facebook',
            href: site.contact.messengerHref,
            colour: '#0084FF',
            ext: true,
            icon: 'M12 2C6.3 2 2 6.2 2 11.7c0 3.1 1.4 5.9 3.7 7.7v3.8l3.4-1.9c.9.3 1.9.4 2.9.4 5.7 0 10-4.2 10-9.7S17.7 2 12 2zm1 13.1-2.6-2.7-5 2.7 5.5-5.8 2.6 2.7 4.9-2.7-5.4 5.8z',
          },
          {
            label: 'WhatsApp',
            sub: site.contact.mobile,
            href: site.contact.whatsappHref,
            colour: '#25D366',
            ext: true,
            icon: 'M17.5 14.4c-.3-.2-1.7-.9-2-1-.3-.1-.5-.1-.7.1-.2.3-.7 1-.9 1.2-.2.2-.3.2-.6.1-.3-.2-1.2-.5-2.3-1.4-.9-.8-1.4-1.7-1.6-2-.2-.3 0-.5.1-.6l.5-.5c.1-.2.2-.3.3-.5 0-.2 0-.4-.1-.5l-1-2.3c-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.2.2 2.1 3.2 5.1 4.5.7.3 1.3.5 1.7.6.7.2 1.4.2 1.9.1.6-.1 1.7-.7 2-1.4.2-.7.2-1.3.2-1.4-.1-.2-.3-.3-.6-.4zM12 2C6.5 2 2 6.5 2 12c0 1.8.5 3.4 1.3 4.9L2 22l5.3-1.4c1.4.8 3 1.2 4.7 1.2 5.5 0 10-4.5 10-10S17.5 2 12 2z',
          },
          {
            label: 'Call the clinic',
            sub: site.contact.mobile,
            href: site.contact.mobileHref,
            colour: '#5B0F00',
            ext: false,
            icon: 'M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1-9.4 0-17-7.6-17-17 0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.6.1.3 0 .7-.2 1l-2.3 2.2z',
          },
        ].map((c, i) => (
          <a
            href={c.href}
            target={c.ext ? '_blank' : undefined}
            rel={c.ext ? 'noopener noreferrer' : undefined}
            class="card-hover group flex items-center gap-5 p-7"
            data-reveal
            style={`--reveal-delay:${i * 80}ms`}
          >
            <span
              class="flex h-13 w-13 shrink-0 items-center justify-center rounded-full p-3.5 text-white transition-transform duration-300 group-hover:scale-105"
              style={`background:${c.colour}`}
              aria-hidden="true"
            >
              <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
                <path d={c.icon} />
              </svg>
            </span>
            <span>
              <span class="block text-[1.15rem] font-medium text-ink">{c.label}</span>
              <span class="block text-[0.88rem] text-ink-mute">{c.sub}</span>
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <!-- ========== Request form ========== -->
  <section class="relative overflow-hidden bg-paper-warm py-24 sm:py-32" aria-labelledby="form-heading">
    <div class="wrap">
      <div class="grid gap-14 lg:grid-cols-[1fr_1fr] lg:gap-20">
        <div data-reveal>
          <span class="eyebrow"><span class="h-px w-8 bg-gold-500"></span>Or send a request</span>
          <h2 id="form-heading" class="mt-6 text-4xl sm:text-5xl">
            Rather write it out?
          </h2>
          <p class="mt-6 max-w-md leading-relaxed text-ink-soft">
            Fill this in and it will open your email app with everything already written. The clinic
            replies with available slots.
          </p>

          <dl class="mt-12 space-y-6">
            <div class="border-l-2 border-gold-500/40 pl-5">
              <dt class="text-[0.72rem] uppercase tracking-[0.14em] text-ink-mute">The screening</dt>
              <dd class="mt-1.5 font-display text-3xl text-ox-600">{site.screening.priceDisplay}</dd>
              <dd class="text-[0.9rem] text-ink-mute">
                {site.screening.duration} · ages {site.screening.minAge}+
              </dd>
            </div>
            <div class="border-l-2 border-gold-500/40 pl-5">
              <dt class="text-[0.72rem] uppercase tracking-[0.14em] text-ink-mute">Clinic hours</dt>
              <dd class="mt-1.5 text-ink">Monday – Friday<br />10:00 am – 7:00 pm</dd>
            </div>
            <div class="border-l-2 border-gold-500/40 pl-5">
              <dt class="text-[0.72rem] uppercase tracking-[0.14em] text-ink-mute">Where</dt>
              <dd class="mt-1.5 leading-relaxed text-ink">{site.address.full}</dd>
            </div>
          </dl>
        </div>

        <form class="card p-8 sm:p-10" data-booking-form novalidate data-reveal style="--reveal-delay:100ms">
          <div class="space-y-5">
            <div>
              <label for="bk-name" class="block text-[0.85rem] font-medium text-ink">
                Your name <span class="text-signal" aria-hidden="true">*</span>
              </label>
              <input
                id="bk-name"
                name="name"
                type="text"
                required
                autocomplete="name"
                class="mt-2 w-full rounded-xl border border-ink/15 bg-white/70 px-4 py-3 text-ink
                       transition-colors placeholder:text-ink-mute/60 focus:border-ox-600 focus:outline-none"
                placeholder="Juan Dela Cruz"
              />
            </div>

            <div class="grid gap-5 sm:grid-cols-2">
              <div>
                <label for="bk-phone" class="block text-[0.85rem] font-medium text-ink">
                  Mobile <span class="text-signal" aria-hidden="true">*</span>
                </label>
                <input
                  id="bk-phone"
                  name="phone"
                  type="tel"
                  required
                  autocomplete="tel"
                  class="mt-2 w-full rounded-xl border border-ink/15 bg-white/70 px-4 py-3 text-ink
                         transition-colors placeholder:text-ink-mute/60 focus:border-ox-600 focus:outline-none"
                  placeholder="0917 000 0000"
                />
              </div>
              <div>
                <label for="bk-email" class="block text-[0.85rem] font-medium text-ink">Email</label>
                <input
                  id="bk-email"
                  name="email"
                  type="email"
                  autocomplete="email"
                  class="mt-2 w-full rounded-xl border border-ink/15 bg-white/70 px-4 py-3 text-ink
                         transition-colors placeholder:text-ink-mute/60 focus:border-ox-600 focus:outline-none"
                  placeholder="you@email.com"
                />
              </div>
            </div>

            <div>
              <label for="bk-when" class="block text-[0.85rem] font-medium text-ink">
                Preferred day or time
              </label>
              <input
                id="bk-when"
                name="when"
                type="text"
                class="mt-2 w-full rounded-xl border border-ink/15 bg-white/70 px-4 py-3 text-ink
                       transition-colors placeholder:text-ink-mute/60 focus:border-ox-600 focus:outline-none"
                placeholder="Weekday afternoons, for example"
              />
            </div>

            <fieldset>
              <legend class="block text-[0.85rem] font-medium text-ink">
                What are you experiencing?
              </legend>
              <div class="mt-3 flex flex-wrap gap-2">
                {
                  symptoms.map((s) => (
                    <label class="group cursor-pointer">
                      <input type="checkbox" class="sr-only" name="symptom" value={s.short} />
                      <span
                        class="inline-block rounded-full border border-ink/15 bg-white/60 px-4 py-1.5 text-[0.85rem] text-ink-soft
                               transition-all duration-300 group-hover:border-gold-500/50
                               group-has-[:checked]:border-gold-500 group-has-[:checked]:bg-gold-500/15 group-has-[:checked]:text-ink"
                      >
                        {s.short}
                      </span>
                    </label>
                  ))
                }
              </div>
            </fieldset>

            <div>
              <label for="bk-notes" class="block text-[0.85rem] font-medium text-ink">
                Anything else we should know?
              </label>
              <textarea
                id="bk-notes"
                name="notes"
                rows="4"
                class="mt-2 w-full resize-y rounded-xl border border-ink/15 bg-white/70 px-4 py-3 text-ink
                       transition-colors placeholder:text-ink-mute/60 focus:border-ox-600 focus:outline-none"
                placeholder="How long it has been going on, what you have already tried…"></textarea>
            </div>

            <label class="group flex cursor-pointer gap-3.5">
              <input type="checkbox" class="sr-only" name="consent" required data-consent />
              <span
                class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-md border border-ink/25
                       transition-all duration-300 group-has-[:checked]:border-gold-500 group-has-[:checked]:bg-gold-500"
                aria-hidden="true"
              >
                <svg
                  width="11"
                  height="9"
                  viewBox="0 0 12 10"
                  fill="none"
                  class="scale-0 transition-transform duration-300 group-has-[:checked]:scale-100"
                >
                  <path
                    d="M1 5l3.2 3.2L11 1.4"
                    stroke="#fff"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"></path>
                </svg>
              </span>
              <span class="text-[0.85rem] leading-relaxed text-ink-soft">
                I agree that DBU Dental Care may contact me about this request, as described in the
                <a href="/privacy-policy" class="font-medium text-ox-600 underline underline-offset-4">
                  Privacy Policy</a
                >.
              </span>
            </label>

            <p class="hidden text-[0.85rem] text-signal" data-form-error role="alert"></p>

            <button type="submit" class="btn-primary w-full">Send booking request</button>

            <p class="text-[0.78rem] leading-relaxed text-ink-mute">
              This opens your email app with the request pre-filled. Nothing is sent until you press
              send there. Prefer chat? Use Messenger or WhatsApp above.
            </p>
          </div>
        </form>
      </div>
    </div>
  </section>

  <!-- ========== Prep + payment ========== -->
  <section class="wrap py-24 sm:py-32">
    <div class="grid gap-5 md:grid-cols-2">
      <div class="card p-9" data-reveal>
        <h2 class="text-2xl">What to bring</h2>
        <ul class="mt-6 space-y-3.5">
          {
            [
              'Any previous X-rays, scans or dental records you have',
              'A list of treatments you have already tried',
              'Any mouthguard or appliance you have been given',
              'Names of medications you are currently taking',
            ].map((item) => (
              <li class="flex gap-3.5 leading-relaxed text-ink-soft">
                <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-gold-500" aria-hidden="true" />
                {item}
              </li>
            ))
          }
        </ul>
      </div>

      <div class="card p-9" data-reveal style="--reveal-delay:80ms">
        <h2 class="text-2xl">Payment</h2>
        <p class="mt-5 leading-relaxed text-ink-soft">{site.payment.hmo}</p>
        <p class="mt-3 leading-relaxed text-ink-soft">{site.payment.installmentNote}</p>
        <ul class="mt-5 flex flex-wrap gap-2">
          {
            site.payment.installments.map((bank) => (
              <li class="rounded-full border border-gold-500/30 bg-gold-500/[0.08] px-4 py-1.5 text-[0.85rem] text-ink">
                {bank}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-booking-form]');

  if (form) {
    const errorEl = form.querySelector<HTMLElement>('[data-form-error]')!;

    const showError = (msg: string) => {
      errorEl.textContent = msg;
      errorEl.classList.remove('hidden');
    };

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      errorEl.classList.add('hidden');

      const data = new FormData(form);
      const name = String(data.get('name') ?? '').trim();
      const phone = String(data.get('phone') ?? '').trim();
      const email = String(data.get('email') ?? '').trim();
      const when = String(data.get('when') ?? '').trim();
      const notes = String(data.get('notes') ?? '').trim();
      const picked = data.getAll('symptom').map(String);

      if (!name) return showError('Please add your name so the clinic knows who is booking.');
      if (!phone) return showError('Please add a mobile number the clinic can reply to.');
      if (!data.get('consent'))
        return showError('Please tick the consent box so we may contact you.');

      const lines = [
        'TMJ Health Screening - booking request',
        '',
        `Name: ${name}`,
        `Mobile: ${phone}`,
        email ? `Email: ${email}` : null,
        when ? `Preferred time: ${when}` : null,
        picked.length ? `Symptoms: ${picked.join(', ')}` : null,
        notes ? `\nNotes:\n${notes}` : null,
        '',
        'Sent from dbudentalcare.com',
      ].filter(Boolean);

      const href =
        `mailto:support@dbudentalcare.com` +
        `?subject=${encodeURIComponent(`Booking request - ${name}`)}` +
        `&body=${encodeURIComponent(lines.join('\n'))}`;

      window.location.href = href;
    });
  }
</script>
