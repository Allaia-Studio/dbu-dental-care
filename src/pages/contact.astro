---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { site } from '../data/site';

const mapQuery = encodeURIComponent(site.address.mapsQuery);
---

<Base
  title="Contact & Directions - DBU Dental Care, Makati"
  description="DBU Dental Care, ground floor, 7405 M. Santillan Street, Makati City. Call (0917) 529 9649, or message us on Messenger or WhatsApp."
>
  <PageHero
    eyebrow="Contact"
    title="Come and see us in Makati."
    lede="Ground floor, Pio del Pilar. Open Monday to Friday, 10:00 am to 7:00 pm."
  />

  <section class="wrap py-24 sm:py-32">
    <div class="grid gap-14 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16">
      <!-- Details -->
      <div data-reveal>
        <h2 class="text-3xl">Get in touch</h2>

        <dl class="mt-9 space-y-px">
          <div class="flex flex-wrap items-baseline gap-x-6 gap-y-1 border-t border-ink/10 py-5">
            <dt class="w-24 shrink-0 text-[0.72rem] uppercase tracking-[0.14em] text-ink-mute">
              Mobile
            </dt>
            <dd>
              <a
                href={site.contact.mobileHref}
                class="text-[1.15rem] text-ink transition-colors hover:text-ox-600"
              >
                {site.contact.mobile}
              </a>
            </dd>
          </div>

          <div class="flex flex-wrap items-baseline gap-x-6 gap-y-1 border-t border-ink/10 py-5">
            <dt class="w-24 shrink-0 text-[0.72rem] uppercase tracking-[0.14em] text-ink-mute">
              Landline
            </dt>
            <dd>
              <a
                href={site.contact.phoneHref}
                class="text-[1.15rem] text-ink transition-colors hover:text-ox-600"
              >
                {site.contact.phone}
              </a>
            </dd>
          </div>

          <div class="flex flex-wrap items-baseline gap-x-6 gap-y-1 border-t border-ink/10 py-5">
            <dt class="w-24 shrink-0 text-[0.72rem] uppercase tracking-[0.14em] text-ink-mute">
              Email
            </dt>
            <dd>
              <a
                href={`mailto:${site.contact.email}`}
                class="break-all text-[1.15rem] text-ink transition-colors hover:text-ox-600"
              >
                {site.contact.email}
              </a>
            </dd>
          </div>

          <div class="flex flex-wrap items-baseline gap-x-6 gap-y-1 border-t border-ink/10 py-5">
            <dt class="w-24 shrink-0 text-[0.72rem] uppercase tracking-[0.14em] text-ink-mute">
              Address
            </dt>
            <dd class="flex-1 leading-relaxed text-ink">
              {site.address.street}<br />
              {site.address.district}, {site.address.city}<br />
              {site.address.country} {site.address.postalCode}
            </dd>
          </div>

          <div class="flex flex-wrap items-baseline gap-x-6 gap-y-1 border-t border-b border-ink/10 py-5">
            <dt class="w-24 shrink-0 text-[0.72rem] uppercase tracking-[0.14em] text-ink-mute">
              Hours
            </dt>
            <dd class="flex-1">
              {
                site.hours.display.map((h) => (
                  <p class="flex justify-between gap-6 text-ink">
                    <span>{h.days}</span>
                    <span class={h.open ? 'text-gold-600' : 'text-ink-mute'}>{h.time}</span>
                  </p>
                ))
              }
            </dd>
          </div>
        </dl>

        <div class="mt-10 flex flex-wrap gap-3">
          <a
            href={site.contact.messengerHref}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary"
          >
            Messenger
          </a>
          <a
            href={site.contact.whatsappHref}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-ghost"
          >
            WhatsApp
          </a>
          <a href="/book" class="btn-ghost">Book a screening</a>
        </div>
      </div>

      <!-- Map -->
      <div data-reveal style="--reveal-delay:100ms">
        <div class="overflow-hidden rounded-[2rem] border border-ink/[0.08]">
          <iframe
            title={`Map showing ${site.name} in Makati City`}
            src={`https://www.google.com/maps?q=${mapQuery}&output=embed`}
            width="100%"
            height="480"
            style="border:0"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen></iframe>
        </div>

        <a
          href={`https://www.google.com/maps/search/?api=1&query=${mapQuery}`}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-ghost mt-5 w-full"
        >
          Open in Google Maps
        </a>

        <div class="mt-5 rounded-2xl border border-ink/[0.08] bg-paper-warm p-6">
          <h3 class="text-[0.7rem] font-medium uppercase tracking-[0.2em] text-ink-mute">
            Finding us
          </h3>
          <p class="mt-3 leading-relaxed text-ink-soft">
            The clinic is on the <strong class="font-medium text-ink">ground floor</strong>, so there
            are no stairs or lifts between the street and reception. If you are having trouble
            finding the entrance, call {site.contact.mobile} and someone will guide you in.
          </p>
        </div>
      </div>
    </div>
  </section>
</Base>
