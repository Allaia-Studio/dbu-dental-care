---
import Base from '../layouts/Base.astro';
import SelfCheck from '../components/SelfCheck.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import ClosingCTA from '../components/ClosingCTA.astro';
import Photo from '../components/Photo.astro';
import { site, doctor, pillars, dismissals } from '../data/site';
import { services } from '../data/services';
import { faqs } from '../data/faqs';
import { postsByDate } from '../data/posts';
import { symptoms } from '../data/symptoms';
import BookLink from '../components/BookLink.astro';

const faqSchema = {
  '@type': 'FAQPage',
  '@id': `${site.url}/#faq`,
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const screeningSchema = {
  '@type': 'Service',
  name: site.screening.name,
  serviceType: 'TMJ diagnostic screening',
  provider: { '@id': `${site.url}/#clinic` },
  areaServed: { '@type': 'Country', name: 'Philippines' },
  offers: {
    '@type': 'Offer',
    price: String(site.screening.price),
    priceCurrency: 'PHP',
    availability: 'https://schema.org/InStock',
    url: `${site.url}/book`,
  },
};

const latest = postsByDate.slice(0, 3);
---

<Base
  title={`TMJ & Jaw Pain Specialist in Makati | ${site.name}`}
  description="Jaw pain, clicking, headaches or ear pain no one can explain? DBU Dental Care, Makati specialises in TMJ. 15-minute screening, Php 3,800."
  schema={[faqSchema, screeningSchema]}
>
  <!-- ==================== HERO ==================== -->
  <section class="relative overflow-hidden bg-paper-warm">
    <div
      class="pointer-events-none absolute -left-40 top-10 h-[38rem] w-[38rem] rounded-full bg-gold-500/12 blur-[120px]"
      aria-hidden="true"
    >
    </div>
    <div
      class="pointer-events-none absolute -right-32 bottom-0 h-[30rem] w-[30rem] rounded-full bg-ox-600/[0.07] blur-[110px]"
      aria-hidden="true"
    >
    </div>

    <div class="wrap-wide relative grid items-center gap-14 pb-24 pt-16 lg:grid-cols-[1.25fr_0.75fr] lg:gap-16 lg:pb-32 lg:pt-24">
      <div>
        <span class="eyebrow" data-reveal>
          <span class="h-px w-8 bg-gold-500"></span>
          {site.positioning}
        </span>

        <h1
          class="mt-7 text-[3.1rem] leading-[0.98] sm:text-7xl lg:text-[5.6rem]"
          data-reveal
          style="--reveal-delay:60ms"
        >
          You don't have to<br class="hidden sm:block" />
          <span class="italic text-gold-600">live with</span> TMJ pain.
        </h1>

        <p
          class="mt-8 max-w-xl text-lg leading-relaxed text-ink-soft sm:text-xl"
          data-reveal
          style="--reveal-delay:140ms"
        >
          Helping patients across the Philippines overcome TMJ Dysfunction and restore their quality
          of life - from a Makati clinic where the jaw joint is the specialty, not a sideline.
        </p>

        <div class="mt-10 flex flex-wrap items-center gap-4" data-reveal style="--reveal-delay:220ms">
          <BookLink class="btn-primary" data-magnetic="0.2">
            Book a TMJ Screening
            <span class="text-paper/55">- {site.screening.priceDisplay}</span>
          </BookLink>
          <a href="#self-check" class="btn-ghost">Take the 1-minute self-check</a>
        </div>

        <dl
          class="mt-14 grid max-w-lg grid-cols-3 gap-6 border-t border-ink/10 pt-8"
          data-reveal
          style="--reveal-delay:300ms"
        >
          <div>
            <dt class="text-[0.72rem] uppercase tracking-[0.14em] text-ink-mute">Program</dt>
            <dd class="mt-1.5 font-display text-3xl text-ox-600">{doctor.yearsCurating} yrs</dd>
            <dd class="text-[0.8rem] text-ink-mute">in the making</dd>
          </div>
          <div>
            <dt class="text-[0.72rem] uppercase tracking-[0.14em] text-ink-mute">Screening</dt>
            <dd class="mt-1.5 font-display text-3xl text-ox-600">15 min</dd>
            <dd class="text-[0.8rem] text-ink-mute">structured diagnostic</dd>
          </div>
          <div>
            <dt class="text-[0.72rem] uppercase tracking-[0.14em] text-ink-mute">Treatment</dt>
            <dd class="mt-1.5 font-display text-3xl text-ox-600">Non-<wbr />surgical</dd>
            <dd class="text-[0.8rem] text-ink-mute">and personalised</dd>
          </div>
        </dl>
      </div>

      <!-- Profile photo with the brand mark floated over it -->
      <div class="relative hidden lg:block" data-reveal style="--reveal-delay:180ms">
        <Photo
          src="/photos/profile-hero"
          alt="A woman photographed in profile, her jaw and cheekbone lit from the side"
          ratio="4/5"
          tone="cool"
          sizes="(min-width: 1024px) 34vw, 100vw"
          loading="eager"
          fetchpriority="high"
          mark
        />

        <div
          class="absolute -bottom-10 -left-12 w-[15.5rem] rounded-[1.5rem] border border-ink/[0.07]
                 bg-paper/95 p-6 shadow-[0_28px_60px_-28px_rgba(28,22,19,0.5)] backdrop-blur-md"
        >
          <img src="/brand/dbu-logo.png" alt="" width="3197" height="1972" class="w-full" />
          <p class="mt-4 border-t border-ink/10 pt-4 text-[0.78rem] leading-relaxed text-ink-mute">
            The mark holds a head in profile, with the pain radiating from a single point - the
            temporomandibular joint.
          </p>
        </div>
      </div>
    </div>

    <!-- Symptom marquee -->
    <div class="relative overflow-hidden border-y border-ink/[0.07] bg-paper py-4">
      <div class="marquee-track flex w-max gap-3">
        {
          [...symptoms, ...symptoms].map((s) => (
            <span class="flex shrink-0 items-center gap-3 rounded-full border border-ink/[0.09] bg-white/60 px-5 py-2 text-[0.85rem] text-ink-soft">
              <span class="h-1.5 w-1.5 rounded-full bg-signal" aria-hidden="true" />
              {s.short}
            </span>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ==================== DISMISSED ==================== -->
  <section class="wrap py-24 sm:py-32" aria-labelledby="dismissed-heading">
    <div class="max-w-3xl" data-reveal>
      <span class="eyebrow">
        <span class="h-px w-8 bg-gold-500"></span>
        Sound familiar?
      </span>
      <h2 id="dismissed-heading" class="mt-6 text-4xl sm:text-5xl lg:text-6xl">
        Most of our patients arrive after being told
        <span class="italic text-gold-600">nothing is wrong.</span>
      </h2>
    </div>

    <div class="mt-14 grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:items-center lg:gap-16">
      <div data-reveal>
        <Photo
          src="/photos/hand-to-jaw"
          alt="A woman resting her fingers against her jaw joint, just in front of the ear"
          ratio="4/5"
          tone="warm"
          sizes="(min-width: 1024px) 38vw, 100vw"
        />
        <p class="mt-4 text-[0.8rem] leading-relaxed text-ink-mute">
          The spot most patients press without thinking - the joint itself, just in front of the ear.
        </p>
      </div>

      <ul class="grid gap-5 sm:grid-cols-1">
      {
        dismissals.map((quote, i) => (
          <li class="card-hover p-8" data-reveal style={`--reveal-delay:${i * 90}ms`}>
            <svg
              width="30"
              height="24"
              viewBox="0 0 30 24"
              fill="none"
              aria-hidden="true"
              class="text-gold-500"
            >
              <path
                d="M0 24V13.4C0 5.9 3.9 1.4 11.2 0l1.3 3.6c-4 1-6 3.2-6.2 6.6H12V24H0zm18 0V13.4C18 5.9 21.9 1.4 29.2 0l1.3 3.6c-4 1-6 3.2-6.2 6.6H30V24H18z"
                fill="currentColor"
                opacity="0.35"
              />
            </svg>
            <blockquote class="mt-6 font-display text-[1.35rem] leading-snug text-ink">
              {quote}
            </blockquote>
          </li>
        ))
      }
      </ul>
    </div>

    <div class="mt-14 flex flex-col items-start gap-6 rounded-[2rem] border border-gold-500/25 bg-gold-500/[0.06] p-8 sm:flex-row sm:items-center sm:justify-between sm:p-10" data-reveal>
      <p class="max-w-2xl text-[1.15rem] leading-relaxed text-ink">
        Each of those symptoms has a real mechanism behind it. The self-check below shows you which
        ones point back to the jaw joint, and why.
      </p>
      <a href="#self-check" class="btn-primary shrink-0" data-magnetic="0.18">See the connection</a>
    </div>
  </section>

  <!-- ==================== SELF CHECK ==================== -->
  <SelfCheck />

  <!-- ==================== SERVICES (bento) ==================== -->
  <section class="wrap py-24 sm:py-32" aria-labelledby="services-heading">
    <div class="flex flex-col justify-between gap-8 md:flex-row md:items-end" data-reveal>
      <div class="max-w-2xl">
        <span class="eyebrow">
          <span class="h-px w-8 bg-gold-500"></span>
          What we treat
        </span>
        <h2 id="services-heading" class="mt-6 text-4xl sm:text-5xl lg:text-6xl">
          Start with the question you actually have.
        </h2>
      </div>
      <a href="/dental-services" class="btn-ghost shrink-0">All services</a>
    </div>

    <div class="mt-14 grid gap-5 md:grid-cols-6">
      {
        services.map((s, i) => (
          <a
            href={`/dental-services#${s.id}`}
            class:list={[
              'card-hover group flex flex-col justify-between p-8 sm:p-9',
              i < 2 ? 'md:col-span-3' : 'md:col-span-2',
            ]}
            data-reveal
            style={`--reveal-delay:${i * 70}ms`}
          >
            <div>
              <p class="font-display text-[1.05rem] italic text-gold-600">“{s.question}”</p>
              <h3 class="mt-4 text-2xl sm:text-[1.75rem]">{s.title}</h3>
              <p class="mt-4 leading-relaxed text-ink-soft">{s.summary}</p>
            </div>

            <div class="mt-8 flex items-center justify-between border-t border-ink/[0.09] pt-5">
              <span class="text-[0.85rem] font-medium text-ink-mute">
                {s.price ?? 'Assessed at screening'}
              </span>
              <span
                class="flex h-9 w-9 items-center justify-center rounded-full border border-ink/15 transition-all duration-300 group-hover:border-gold-500 group-hover:bg-gold-500 group-hover:text-white"
                aria-hidden="true"
              >
                <svg width="13" height="13" viewBox="0 0 14 14" fill="none">
                  <path
                    d="M1 13L13 1M13 1H4M13 1v9"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <!-- ==================== WHY DBU ==================== -->
  <section class="relative overflow-hidden bg-paper-warm py-24 sm:py-32" aria-labelledby="why-heading">
    <div class="wrap">
      <div class="grid gap-14 lg:grid-cols-[0.9fr_1.1fr] lg:gap-20">
        <div class="lg:sticky lg:top-28 lg:self-start" data-reveal>
          <span class="eyebrow">
            <span class="h-px w-8 bg-gold-500"></span>
            Why DBU
          </span>
          <h2 id="why-heading" class="mt-6 text-4xl sm:text-5xl">
            A clinic built around one joint.
          </h2>
          <p class="mt-6 max-w-md leading-relaxed text-ink-soft">
            {doctor.name} is the DBU in DBU Dental Care. She spent {doctor.yearsCurating} years
            curating the TMJ Pain Management Program after living the patient journey herself.
          </p>
          <a href="/about" class="btn-ghost mt-8">Meet Dr. Uy</a>
        </div>

        <ol class="space-y-px">
          {
            pillars.map((p, i) => (
              <li
                class="group flex gap-7 border-t border-ink/10 py-8 last:border-b"
                data-reveal
                style={`--reveal-delay:${i * 80}ms`}
              >
                <span class="font-display text-2xl text-gold-500/60 transition-colors duration-300 group-hover:text-gold-600">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <div>
                  <h3 class="text-2xl">{p.title}</h3>
                  <p class="mt-3 max-w-xl leading-relaxed text-ink-soft">{p.body}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <!-- ==================== CLINIC ==================== -->
  <section class="wrap py-24 sm:py-32" aria-labelledby="clinic-heading">
    <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
      <div class="relative" data-reveal>
        <!-- The clinic's own photograph of their X-ray suite, layered with a
             wider shot of imaging being read. -->
        <div class="overflow-hidden rounded-[1.75rem]">
          <img
            src="/photos/clinic-xray.jpg"
            alt="The digital panoramic X-ray suite at DBU Dental Care in Makati"
            width="533"
            height="533"
            loading="lazy"
            decoding="async"
            class="aspect-[4/5] w-full object-cover"
            style="filter:saturate(0.72) contrast(1.04) sepia(0.1)"
          />
        </div>

        <div class="absolute -bottom-10 -right-6 w-[58%] sm:-right-10 sm:w-[52%]">
          <Photo
            src="/photos/reading-xrays"
            alt="A clinician holding dental X-ray films up against a lightbox to read them"
            ratio="3/2"
            tone="cool"
            sizes="(min-width: 1024px) 24vw, 45vw"
            class="!rounded-[1.25rem] shadow-[0_28px_60px_-28px_rgba(28,22,19,0.55)] ring-4 ring-paper"
          />
        </div>
      </div>

      <div data-reveal style="--reveal-delay:100ms">
        <span class="eyebrow">
          <span class="h-px w-8 bg-gold-500"></span>
          The clinic
        </span>
        <h2 id="clinic-heading" class="mt-6 text-4xl sm:text-5xl">
          Diagnosis happens in the room, not by referral.
        </h2>
        <p class="mt-6 leading-relaxed text-ink-soft">
          Imaging is done on-site during your visit, so the structure of your joint is reviewed with
          you in the same appointment. For patients who have spent years being sent between
          specialists, that alone changes the experience.
        </p>

        <dl class="mt-10 grid gap-6 sm:grid-cols-2">
          <div class="border-l-2 border-gold-500/40 pl-5">
            <dt class="text-[0.72rem] uppercase tracking-[0.14em] text-ink-mute">Where</dt>
            <dd class="mt-1.5 leading-relaxed text-ink">{site.address.full}</dd>
          </div>
          <div class="border-l-2 border-gold-500/40 pl-5">
            <dt class="text-[0.72rem] uppercase tracking-[0.14em] text-ink-mute">When</dt>
            <dd class="mt-1.5 text-ink">Monday - Friday<br />10:00 am - 7:00 pm</dd>
          </div>
        </dl>

        <div class="mt-9 flex flex-wrap gap-4">
          <a href="/contact" class="btn-primary" data-magnetic="0.18">Directions & contact</a>
          <a href={site.contact.mobileHref} class="btn-ghost">{site.contact.mobile}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== JAW TALK ==================== -->
  <section class="wrap pb-24 sm:pb-32" aria-labelledby="jawtalk-heading">
    <div class="flex flex-col justify-between gap-8 md:flex-row md:items-end" data-reveal>
      <div class="max-w-2xl">
        <span class="eyebrow">
          <span class="h-px w-8 bg-gold-500"></span>
          The Jaw Talk
        </span>
        <h2 id="jawtalk-heading" class="mt-6 text-4xl sm:text-5xl">
          Plain answers about your jaw.
        </h2>
      </div>
      <a href="/the-jaw-talk" class="btn-ghost shrink-0">Read all articles</a>
    </div>

    <div class="mt-14 grid gap-5 md:grid-cols-3">
      {
        latest.map((post, i) => (
          <a
            href={`/the-jaw-talk/${post.slug}`}
            class="card-hover group flex flex-col p-8"
            data-reveal
            style={`--reveal-delay:${i * 80}ms`}
          >
            <span class="eyebrow !text-gold-600">{post.category}</span>
            <h3 class="mt-4 text-2xl transition-colors duration-300 group-hover:text-ox-600">
              {post.title}
            </h3>
            <p class="mt-4 flex-1 leading-relaxed text-ink-soft">{post.excerpt}</p>
            <span class="mt-7 text-[0.82rem] text-ink-mute">{post.readingMinutes} min read</span>
          </a>
        ))
      }
    </div>
  </section>

  <FaqAccordion items={faqs.slice(0, 6)} />

  <ClosingCTA />
</Base>
