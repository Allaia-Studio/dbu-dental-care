---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---

<Base title="Page not found" description="That page does not exist." noindex>
  <section class="wrap flex min-h-[62vh] flex-col justify-center py-24">
    <div class="ring-pulse relative mb-10 h-14 w-14" aria-hidden="true">
      <span class="absolute inset-0 rounded-full border border-signal/70"></span>
      <span class="absolute inset-0 rounded-full border border-signal/70"></span>
      <span class="absolute inset-0 rounded-full border border-signal/70"></span>
      <span
        class="absolute left-1/2 top-1/2 h-2.5 w-2.5 -translate-x-1/2 -translate-y-1/2 rounded-full bg-signal"
      ></span>
    </div>

    <p class="eyebrow">404</p>
    <h1 class="mt-5 max-w-2xl text-5xl sm:text-6xl">This page isn't where it should be.</h1>
    <p class="mt-6 max-w-lg text-lg leading-relaxed text-ink-soft">
      Much like a jaw joint, then. Let's get you back to something useful.
    </p>

    <div class="mt-10 flex flex-wrap gap-4">
      <a href="/" class="btn-primary">Back to home</a>
      <a href="/tmj-self-check" class="btn-ghost">Take the TMJ self-check</a>
      <a href={site.contact.mobileHref} class="btn-ghost">Call {site.contact.mobile}</a>
    </div>
  </section>
</Base>
