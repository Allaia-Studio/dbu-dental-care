---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ClosingCTA from '../components/ClosingCTA.astro';
import { site, doctor } from '../data/site';

const therapySchema = {
  '@type': 'MedicalTherapy',
  name: 'TMJ Pain Management Program',
  description:
    'A personalised, non-surgical treatment program for TMJ Dysfunction, developed over ten years by Dr. Diana Beverly Uy at DBU Dental Care in Makati.',
  provider: { '@id': `${site.url}/#clinic` },
  relevantSpecialty: 'Dentistry',
};

const stages = [
  {
    n: '01',
    t: 'Screening',
    d: `A ${site.screening.duration} structured diagnostic that assesses the joint, the bite and the muscle pattern together. You leave knowing whether TMJ Dysfunction is what you are dealing with.`,
    meta: site.screening.priceDisplay,
  },
  {
    n: '02',
    t: 'Mapping your pattern',
    d: 'Which symptoms trace back to the joint, how your teeth meet when you close, where the muscles are overloaded, and which habits keep re-loading them. On-site imaging is reviewed with you.',
    meta: 'In-clinic imaging',
  },
  {
    n: '03',
    t: 'Your personalised plan',
    d: 'Built around your own diagnosis rather than a standard protocol. Non-surgical throughout, and paced to what your joint and muscles can actually take.',
    meta: 'Non-surgical',
  },
  {
    n: '04',
    t: 'Holding the result',
    d: 'The part most treatment skips. Relief that does not hold is the reason so many patients arrive having already "tried everything" - so the program addresses recurrence directly.',
    meta: 'Long-term',
  },
];
---

<Base
  title="TMJ Pain Management Program - Makati"
  description="A personalised, non-surgical TMJ program developed over ten years by Dr. Diana Beverly Uy, built around your own bite and symptom pattern."
  schema={[therapySchema]}
>
  <PageHero
    eyebrow="The Program"
    title="Ten years in the making, then rebuilt for you."
    lede={`${doctor.name} curated the TMJ Pain Management Program over ${doctor.yearsCurating} years - first because she needed it herself, then because it worked for the patients who came after.`}
  />

  <!-- Origin -->
  <section class="wrap py-24 sm:py-32">
    <div class="grid gap-14 lg:grid-cols-[1.15fr_0.85fr] lg:gap-20">
      <div data-reveal>
        <span class="eyebrow"><span class="h-px w-8 bg-gold-500"></span>Where it came from</span>
        <h2 class="mt-6 text-4xl sm:text-5xl">
          Designed by someone who had been the patient.
        </h2>
        <div class="mt-8 max-w-2xl space-y-5 text-[1.08rem] leading-relaxed text-ink-soft">
          <p>
            {doctor.name} understands how difficult the patient journey of a TMJ patient is. She
            pursued specialised studies focusing on the intersection of dentistry and medicine, and
            over ten years curated a program that worked for her - and for many others since.
          </p>
          <p>
            That origin shows up in how the program is structured. It assumes you have already tried
            things. It assumes you have been told it was stress. It starts by establishing what is
            actually happening, because for most patients that has never been done.
          </p>
        </div>
      </div>

      <aside class="card p-9" data-reveal style="--reveal-delay:100ms">
        <h3 class="text-[0.7rem] font-medium uppercase tracking-[0.2em] text-ink-mute">
          What "non-surgical" means here
        </h3>
        <ul class="mt-6 space-y-4">
          {
            [
              'No jaw surgery as part of the program',
              'Treatment paced to your joint and muscles',
              'Planned around your bite, not a standard appliance',
              'Reviewed as your symptom pattern changes',
            ].map((item) => (
              <li class="flex gap-3.5 leading-relaxed text-ink-soft">
                <span
                  class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-gold-500"
                  aria-hidden="true"
                />
                {item}
              </li>
            ))
          }
        </ul>
      </aside>
    </div>
  </section>

  <!-- Stages -->
  <section class="relative overflow-hidden bg-paper-warm py-24 sm:py-32" aria-labelledby="stages-heading">
    <div class="wrap">
      <div class="max-w-2xl" data-reveal>
        <span class="eyebrow"><span class="h-px w-8 bg-gold-500"></span>How it runs</span>
        <h2 id="stages-heading" class="mt-6 text-4xl sm:text-5xl lg:text-6xl">
          Four stages, in order.
        </h2>
      </div>

      <ol class="mt-14 grid gap-5 md:grid-cols-2">
        {
          stages.map((s, i) => (
            <li class="card flex flex-col p-9" data-reveal style={`--reveal-delay:${(i % 2) * 80}ms`}>
              <div class="flex items-baseline justify-between gap-4">
                <span class="font-display text-4xl text-gold-500/50">{s.n}</span>
                <span class="rounded-full border border-ink/10 px-3.5 py-1 text-[0.75rem] text-ink-mute">
                  {s.meta}
                </span>
              </div>
              <h3 class="mt-6 text-[1.7rem]">{s.t}</h3>
              <p class="mt-4 leading-relaxed text-ink-soft">{s.d}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Payment -->
  <section class="wrap py-24 sm:py-32">
    <div class="mx-auto max-w-3xl">
      <span class="eyebrow" data-reveal><span class="h-px w-8 bg-gold-500"></span>Paying for treatment</span>
      <h2 class="mt-6 text-4xl sm:text-5xl" data-reveal style="--reveal-delay:60ms">
        Straight answers on cost.
      </h2>

      <div class="mt-10 space-y-5" data-reveal style="--reveal-delay:120ms">
        <div class="rounded-2xl border border-ink/[0.08] bg-white/50 p-7">
          <h3 class="text-xl">The screening is fixed</h3>
          <p class="mt-3 leading-relaxed text-ink-soft">
            The TMJ Health Screening is {site.screening.priceDisplay} for a {site.screening.duration}
            {' '}diagnostic appointment, available from age {site.screening.minAge}. You will know the
            cost before you arrive.
          </p>
        </div>

        <div class="rounded-2xl border border-ink/[0.08] bg-white/50 p-7">
          <h3 class="text-xl">Treatment is quoted after diagnosis</h3>
          <p class="mt-3 leading-relaxed text-ink-soft">
            Because the program is personalised, the cost of treatment depends on what the screening
            finds. The clinic will walk you through it before anything begins.
          </p>
        </div>

        <div class="rounded-2xl border border-ink/[0.08] bg-white/50 p-7">
          <h3 class="text-xl">HMO and installments</h3>
          <p class="mt-3 leading-relaxed text-ink-soft">{site.payment.hmo}</p>
          <p class="mt-3 leading-relaxed text-ink-soft">
            {site.payment.installmentNote} Available through:
          </p>
          <ul class="mt-4 flex flex-wrap gap-2">
            {
              site.payment.installments.map((bank) => (
                <li class="rounded-full border border-gold-500/30 bg-gold-500/[0.08] px-4 py-1.5 text-[0.85rem] text-ink">
                  {bank}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <ClosingCTA
    title="The program starts with one 15-minute appointment."
    lede={`Book the TMJ Health Screening and find out whether the joint is what has been driving your symptoms. ${site.screening.priceDisplay}.`}
  />
</Base>
